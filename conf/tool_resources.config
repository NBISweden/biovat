process {

    // ALIGN_READS subworkflow
    withName: 'PARABRICKS_FQ2BAM' {
        accelerator = { params.gpu_resources
            ? (
                params.gpu_resources.contains(':')
                    ? params.gpu_resources.split(':')[1] as int
                    : params.gpu_resources as int
            )
            : 1
        }
        clusterOptions = {
            [
                "-A ${params.project}",
                "-p ${params.gpu_partition}",
                params.clusterOptions ? "${params.clusterOptions}" : "",
                params.gpu_resources  ? "--gpus=${params.gpu_resources}" : "--gpus=1",
            ].findAll { opt -> opt }.join(" ")
        }
        containerOptions = {
            workflow.containerEngine in ['singularity', 'apptainer']
                ? "--nv"
                : '--gpus all'
            }
    }

}
