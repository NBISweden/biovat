process {

    // ALIGN_READS subworkflow
    withName: PARABRICKS_FQ2BAM {
        accelerator      = {
            params.gpu_resources
                ? (params.gpu_resources.contains(':')
                    ? params.gpu_resources.split(':')[1] as int
                    : params.gpu_resources as int)
                : 1
        }
        containerOptions = {
            workflow.containerEngine in ['singularity', 'apptainer']
                ? "--nv"
                : '--gpus all'
        }
        queue            = { params.gpu_partition }
    }

}
