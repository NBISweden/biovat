/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run biovat -profile test,<docker/singularity>

----------------------------------------------------------------------------------------
*/

// Enable pipeline resume by default
resume = true

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: 'BWA_INDEX' {
            memory = 1.GB
    }
}

params {

    // Test params
    // The paths of the test samplesheet are relative to the repository root. This copy has the paths of this checkout,
    // so -profile test also works from another directory, e.g. with nextflow run NBISweden/biovat. The copy is deleted on
    // exit. A stage pipeline has no sheet at this path (its projectDir is the stage), and is given the path as it is
    input           = new File("${projectDir}/tests/data/monkeyflower/samplesheet.csv").with { source ->
        if ( !source.exists() ) {
            return source.toString()
        }
        def sheet = File.createTempFile('biovat_test_samplesheet_', '.csv')
        sheet.deleteOnExit()
        sheet.text = source.text.replace('./tests/data/monkeyflower', "${projectDir}/tests/data/monkeyflower")
        sheet.toString()
    }
    fasta           = "${projectDir}/tests/data/monkeyflower/M_aurantiacus_v1_splitline_ordered.fasta"
    sample_metadata = "${projectDir}/tests/data/monkeyflower/sample_metadata.csv"
    outdir          = 'results'
    callset_prefix  = 'Diplacus_puniceus_red_yellow'

    // Boilerplate
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

}
