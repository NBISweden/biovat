/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run biovat -profile test,<docker/singularity>

----------------------------------------------------------------------------------------
*/

// Enable pipeline resume by default
resume = true

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: 'BWA_INDEX' {
            memory = 1.GB
    }
}

params {

    // Test params
    // The paths of the test samplesheet are relative to the repository root. A copy with the paths of this checkout is
    // written to the .nextflow directory of the launch directory (launchDir), so -profile test also works from another
    // directory, e.g. with nextflow run NBISweden/biovat. Under nf-test that is the directory of the test. A stage
    // pipeline has no sheet at this path (its projectDir is the stage), and a launch directory that cannot be written
    // to gets the sheet as it is
    input           = new File("${projectDir}/tests/data/monkeyflower/samplesheet.csv").with { source ->
        if ( !source.exists() ) {
            return source.toString()
        }
        try {
            def dir = java.nio.file.Files.createDirectories(launchDir.resolve('.nextflow/biovat_test'))
            def resolved = dir.resolve('samplesheet.csv')
            java.nio.file.Files.writeString(resolved, source.text.replace('./tests/data/monkeyflower', "${projectDir}/tests/data/monkeyflower"))
            return resolved.toString()
        }
        catch ( Exception e ) {
            return source.toString()
        }
    }
    fasta           = "${projectDir}/tests/data/monkeyflower/M_aurantiacus_v1_splitline_ordered.fasta"
    sample_metadata = "${projectDir}/tests/data/monkeyflower/sample_metadata.csv"
    outdir          = 'results'
    callset_prefix  = 'Diplacus_puniceus_red_yellow'

    // Boilerplate
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

}
