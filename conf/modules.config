/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // READ_QC subworkflow
    withName: 'FASTQC' {
        ext.args   = '--quiet'
        ext.prefix = { meta.read_group }
    }

    // TRIM_READS subworkflow
    withName: 'FASTP' {
        ext.prefix = { meta.read_group }
    }

    // ALIGN_READS subworkflow
    withName: 'BWAMEM3_MEM' {
        ext.args   = { "-R '@RG\\tID:${meta.platform_unit}\\tSM:${meta.id}\\tLB:${meta.library}\\tPU:${meta.platform_unit}\\tPL:${meta.pl}'" }
        ext.args2  = {
            [
                "--write-index",
                params.enable_cram_format ? "--output-fmt cram" : ""
            ].minus("").join(" ")
        }
        ext.prefix = { meta.read_group }
    }
    withName: 'PARABRICKS_FQ2BAM' {
        ext.args   = {
            [
                "--read-group-sm ${meta.id}",
                "--read-group-lb ${meta.library}",
                "--read-group-pl ${meta.pl}",
                "--read-group-id-prefix ${meta.platform_unit}",
                "--gpusort",
                "--no-markdups",
                "--gpuwrite"
            ].minus("").join(" ")
        }
        ext.prefix = { meta.read_group }
    }
    withName: 'SAMTOOLS_INDEX' {
        ext.args   = "--csi"
    }

    // ALIGNMENT_QC subworkflow (shared by ALIGN_READS, MERGE_TO_LIBRARY, MARK_DUPLICATES and MERGE_TO_SAMPLE call sites)
    withName: '.*:ALIGNMENT_QC:SAMTOOLS_FLAGSTAT' {
        ext.prefix = { meta.qc_prefix }
    }
    withName: '.*:ALIGNMENT_QC:RIKER_MULTI' {
        ext.args   = '--tools alignment basic isize wgs gcbias'
        ext.prefix = { meta.qc_prefix }
    }
    withName: '.*:ALIGNMENT_QC:QUALIMAP_BAMQC' {
        ext.prefix = { meta.qc_prefix }
    }

    // INGEST_BAM_OR_CRAM subworkflow
    withName: 'SAMTOOLS_ADDREPLACERG' {
        // only reached by inputs with no @RG line. BAM out, as SAMTOOLS_SORT sets the final format
        ext.args   = {
            [
                "-m overwrite_all",
                "--output-fmt bam",
                "-r '@RG\\tID:${meta.platform_unit}\\tSM:${meta.id}\\tLB:${meta.library}\\tPU:${meta.platform_unit}\\tPL:${meta.pl}'"
            ].minus("").join(" ")
        }
        ext.prefix = { "${meta.read_group}_rg" }
    }
    withName: 'SAMTOOLS_SORT' {
        ext.args   = params.enable_cram_format ? "--output-fmt cram" : ""
        ext.prefix = { meta.read_group }
    }

    // MERGE_TO_LIBRARY (readgroup -> library merge, aliased from the shared MERGE subworkflow)
    withName: '.*:MERGE_TO_LIBRARY:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_${meta.library}_${meta.pl}" }
    }

    // MARK_DUPLICATES subworkflow
    withName: 'PICARD_MARKDUPLICATES' {
        ext.args   = {
            [
                // Always report optical metrics, tag the BAM if retaining duplicates
                params.enable_remove_duplicates ? '--REMOVE_DUPLICATES true' : '--TAGGING_POLICY All',
                "--OPTICAL_DUPLICATE_PIXEL_DISTANCE ${params.optical_distance}"
            ].minus("").join(" ")
        }
        ext.prefix = { "${meta.id}_${meta.library}_${meta.pl}_markdup" }
    }
    withName: 'SAMTOOLS_SORMADUP' {
        ext.args5  = {
            [
                params.enable_remove_duplicates ? '-r' : '',
                params.enable_cram_format ? '--output-fmt cram' : '',
                // Always report optical metrics, BAM tagging is automatic
                "-d ${params.optical_distance}",
                '--write-index'
            ].minus("").join(" ")
        }
        ext.prefix = { "${meta.id}_${meta.library}_${meta.pl}_markdup" }
    }

    // MERGE_TO_SAMPLE (library -> sample merge, aliased from the shared MERGE subworkflow)
    withName: '.*:MERGE_TO_SAMPLE:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_${meta.pl}" }
    }

    // CALL_VARIANTS subworkflow
    withName: 'BCFTOOLS_MPILEUP_MULTISAMPLE' {
        ext.args   = {
            [
                params.enable_baq ? '' : '--no-BAQ',
                "${params.bcftools_mpileup_extra}"
            ].minus("").join(" ")
        }
        ext.args2  = {
            [
                params.enable_multiallelic_caller ? '--multiallelic-caller' : '--consensus-caller',
                params.enable_variants_only ? '--variants-only' : '',
                "${params.bcftools_call_extra}"
            ].minus("").join(" ")
        }
    }
    withName: 'BCFTOOLS_CONCAT' {
        ext.args = { "--write-index=csi --output-type z" }
    }
    withName: 'GATK4_HAPLOTYPECALLER' {
        // Per-sample GVCFs for joint genotyping; the .g prefix suffix gives *.g.vcf.gz, which GATK expects for GVCFs
        ext.args   = { '--emit-ref-confidence GVCF' }
        ext.prefix = { "${meta.id}.${meta.chunk}.g" }
    }
    withName: 'GATK4_GENOMICSDBIMPORT' {
        // Import samples in batches of 50, per "broadinstitute/warp" repo code & GATK recommendation
        // https://gatk.broadinstitute.org/hc/en-us/articles/360035889971--How-to-Consolidate-GVCFs-for-joint-calling-with-GenotypeGVCFs
        // Store all contigs of a chunk in one GenomicsDB partition instead of one per contig (better performance for fragmented regions/genomes)
        // https://github.com/broadinstitute/gatk/pull/6681
        ext.args   = { '--batch-size 50 --merge-contigs-into-num-partitions 1' }
    }
    withName: 'GATK4_GENOTYPEGVCFS' {
        // Note: chunks are whole contigs, so no call can span a chunk boundary and no boundary filtering is needed.
        // However, if we eventually support splitting contigs (e.g. contigs too long for a .tbi index), add
        // ext.args = { '--variant-output-filtering STARTS_IN' } here to avoid duplicate calls at chunk boundaries,
        // and drop --merge-contigs-into-num-partitions from GATK4_GENOMICSDBIMPORT, which needs whole contigs
    }

    // VARIANT_QC subworkflow
    withName: 'VCFTOOLS_TSTV_COUNT' {
        ext.args   = { '--TsTv-by-count' }
    }
    withName: 'VCFTOOLS_TSTV_QUAL' {
        ext.args   = { '--TsTv-by-qual' }
    }
    withName: 'VCFTOOLS_SUMMARY' {
        ext.args   = { '--FILTER-summary' }
    }
    withName: 'VCFTOOLS_RELATEDNESS2' {
        ext.args   = { '--relatedness2' }
    }

    // MULTIQC
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

}
