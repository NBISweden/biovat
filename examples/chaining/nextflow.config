// Config for the chaining example. An included pipeline's own nextflow.config is not loaded, so everything
// the example needs to run (container engine, resources) is configured here.

// BioVAT uses nf-schema for its parameter summary and help message, so the including pipeline has to load the plugin
plugins {
    id 'nf-schema@2.8.0'
}

includeConfig '../../conf/base.config'

// The manifest of the calling pipeline is used for the MultiQC methods description and the versions file
manifest {
    name         = 'example/biovat-chaining'
    version      = '0.1.0'
    description  = 'Example of chaining BioVAT with a downstream pipeline'
}

outputDir = 'results_chaining'

process.resourceLimits = [ cpus: 4, memory: '15.GB', time: '1.h' ]

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options, as in the config of BioVAT. Without pipefail a failure in a piped command is not caught
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch  = 'arm64'
        wave.enabled  = true
        wave.freeze   = true
        wave.strategy = 'conda,container'
    }
    gpu {
        // Names the profile for the process_gpu label of base.config. Container engine options are left to the
        // institutional profile or the user's local config
    }
    test {
        params.samples   = "${projectDir}/samplesheet.csv"
        params.reference = "${projectDir}/../../tests/data/monkeyflower/M_aurantiacus_v1_splitline_ordered.fasta"
    }
}
