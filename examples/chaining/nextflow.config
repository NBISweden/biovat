// Config for the chaining example. An included pipeline's own nextflow.config is not loaded, so everything
// the example needs to run (container engine, resources) is configured here.

// BioVAT uses nf-schema for its parameter summary and help message, so the including pipeline has to load the plugin
plugins {
    id 'nf-schema@2.8.0'
}

includeConfig '../../conf/base.config'

// The manifest of the calling pipeline is used for the MultiQC methods description and the versions file
manifest {
    name         = 'example/biovat-chaining'
    version      = '0.1.0'
    description  = 'Example of chaining BioVAT with a downstream pipeline'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}

outputDir = 'results_chaining'

process.resourceLimits = [ cpus: 4, memory: '15.GB', time: '1.h' ]

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch  = 'arm64'
        wave.enabled  = true
        wave.freeze   = true
        wave.strategy = 'conda,container'
    }
    test {
        params.samples   = "${projectDir}/samplesheet.csv"
        params.reference = "${projectDir}/../../tests/data/monkeyflower/M_aurantiacus_v1_splitline_ordered.fasta"
    }
}
