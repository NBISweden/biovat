nextflow_function {

    name "Test samplesheet validation functions"
    script "../main.nf"
    tag "subworkflows"
    tag "utils_nfcore_biovat_pipeline"

    // Rows are the records the entry workflow passes: meta and files. Maps behave the same in these functions

    test("validateSampleMetadata - extra samples warn") {
        function "validateSampleMetadata"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A' ], files: [] ] ]
                input[1] = [ [ id:'A', population:'red' ], [ id:'B', population:'red' ] ]
                input[2] = [ variant_calling: true ]
                input[3] = [ sample_metadata: true, variant_caller: 'bcftools_multisample' ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // log.warn reaches nextflow.log, not the captured stdout
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("--sample_metadata lists sample(s) not in --input, which will be ignored: B") }
            )
        }
    }

    test("validateSampleMetadata - missing population fails") {
        function "validateSampleMetadata"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A' ], files: [] ], [ meta: [ id:'B' ], files: [] ] ]
                input[1] = [ [ id:'A', population:'red' ], [ id:'B' ] ]
                input[2] = [ variant_calling: true ]
                input[3] = [ sample_metadata: true, variant_caller: 'bcftools_multisample' ]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("requires a 'population' for every sample. Missing for: B") } }
            )
        }
    }

    test("validateSampleMetadata - skipped without --sample_metadata") {
        function "validateSampleMetadata"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A' ], files: [] ] ]
                input[1] = []
                input[2] = [ variant_calling: true ]
                input[3] = [ sample_metadata: false, variant_caller: 'bcftools_multisample' ]
                """
            }
        }

        then {
            assert function.success
        }
    }

    test("validateSampleMetadata - ignored with a caller other than bcftools_multisample") {
        function "validateSampleMetadata"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A' ], files: [] ], [ meta: [ id:'B' ], files: [] ] ]
                input[1] = [ [ id:'A', population:'red' ], [ id:'B' ] ]
                input[2] = [ variant_calling: true ]
                input[3] = [ sample_metadata: true, variant_caller: 'gatk' ]
                """
            }
        }

        then {
            assertAll(
                // B has no population, which would fail under bcftools_multisample
                { assert function.success },
                { assert new File("${launchDir}/meta/nextflow.log").text.contains("--sample_metadata is only used by --variant_caller bcftools_multisample, so it is ignored with --variant_caller gatk") }
            )
        }
    }

    test("validateAlignmentConsumers - no alignment source fails") {
        function "validateAlignmentConsumers"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A', input_type:'fastq' ], files: [] ] ]
                input[1] = [ align: false, mark_duplicates: true, variant_calling: true ]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("No alignments to process for --enable_mark_duplicates, --enable_variant_calling") } }
            )
        }
    }

    test("validateAlignmentConsumers - BAM/CRAM rows are an alignment source") {
        function "validateAlignmentConsumers"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A', input_type:'fastq' ], files: [] ], [ meta: [ id:'B', input_type:'bam_cram' ], files: [] ] ]
                input[1] = [ align: false, mark_duplicates: true, variant_calling: true ]
                """
            }
        }

        then {
            assert function.success
        }
    }

    // TEMP: support other platforms
    test("validateVariantCallingPlatforms - no ILLUMINA rows fails") {
        function "validateVariantCallingPlatforms"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A', pl:'ONT' ], files: [] ], [ meta: [ id:'B', pl:'PACBIO' ], files: [] ] ]
                input[1] = [ variant_calling: true ]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("no samplesheet rows have platform ILLUMINA (found: ONT, PACBIO)") } }
            )
        }
    }

    // TEMP: support other platforms
    test("validateVariantCallingPlatforms - mixed platforms pass") {
        function "validateVariantCallingPlatforms"

        when {
            function {
                """
                input[0] = [ [ meta: [ id:'A', pl:'ONT' ], files: [] ], [ meta: [ id:'B', pl:'ILLUMINA' ], files: [] ] ]
                input[1] = [ variant_calling: true ]
                """
            }
        }

        then {
            assert function.success
        }
    }
}
