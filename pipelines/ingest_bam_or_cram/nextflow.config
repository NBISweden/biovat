// Config for running the ingest_bam_or_cram pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/ingest_bam_or_cram'
    description  = 'Validation, sorting and indexing of BAM/CRAM input'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
