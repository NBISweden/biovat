// Config for running the variant_qc pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/variant_qc'
    description  = 'Quality checks of variant calls'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
