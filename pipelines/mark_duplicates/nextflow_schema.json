{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/NBISweden/biovat/main/pipelines/mark_duplicates/nextflow_schema.json",
    "title": "BioVAT mark_duplicates pipeline parameters",
    "description": "Mark duplicates with samtools or Picard",
    "type": "object",
    "$defs": {
        "input_options": {
            "title": "Input options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data.",
            "properties": {
                "samplesheet": {
                    "type": "string",
                    "format": "file-path",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Alignments samplesheet (CSV) with the columns sample, library_id, platform, single_end, alignment and index. library_id is needed for every row.",
                    "fa_icon": "fas fa-file-csv"
                },
                "alignments": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Alternative to --samplesheet: a YAML or JSON file with one entry per library alignment. Fields: meta (a map with id, library and pl), alignment (BAM/CRAM file) and index (its index). Use either --samplesheet or --alignments.",
                    "fa_icon": "fas fa-file"
                }
            }
        },
        "duplicate_marking_options": {
            "title": "Duplicate marking options",
            "type": "object",
            "fa_icon": "fas fa-clone",
            "description": "How to mark duplicates.",
            "properties": {
                "duplicate_marker": {
                    "type": "string",
                    "default": "samtools",
                    "enum": ["picard", "samtools"],
                    "description": "Duplicate marking tool choice.",
                    "fa_icon": "fas fa-wrench"
                },
                "remove_duplicates": {
                    "type": "boolean",
                    "default": false,
                    "description": "Remove alignments identified as duplicates (else mark them).",
                    "fa_icon": "fas fa-trash"
                },
                "optical_distance": {
                    "type": "integer",
                    "default": 100,
                    "description": "Max offset between clusters to be considered optical duplicates. For unpatterned flowcells, use default. Patterned, use 2500.",
                    "fa_icon": "fas fa-ruler"
                }
            }
        },
        "reference_options": {
            "title": "Reference options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Reference genome files.",
            "properties": {
                "fasta": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Reference fasta file. Needed for CRAM output and Riker.",
                    "fa_icon": "fas fa-file"
                },
                "fai": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Fai index of the reference fasta. Used by CRAM output and Riker. Created from --fasta when it is needed and not given.",
                    "fa_icon": "fas fa-file"
                }
            }
        },
        "alignment_qc_options": {
            "title": "Alignment QC options",
            "type": "object",
            "fa_icon": "fas fa-chart-bar",
            "description": "Quality checks on the output alignments.",
            "properties": {
                "cram_format": {
                    "type": "boolean",
                    "default": false,
                    "description": "Write CRAM instead of BAM. Requires --fasta and --fai.",
                    "fa_icon": "fas fa-file"
                },
                "align_qc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run quality checks on the output alignments.",
                    "fa_icon": "fas fa-check"
                },
                "riker": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run Riker in the alignment QC. Requires --fasta and --fai.",
                    "fa_icon": "fas fa-check"
                },
                "qualimap": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run Qualimap in the alignment QC. Not compatible with --cram_format.",
                    "fa_icon": "fas fa-check"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "properties": {
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message.",
                    "fa_icon": "fas fa-question-circle"
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full help message.",
                    "fa_icon": "fas fa-question-circle"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_options"
        },
        {
            "$ref": "#/$defs/duplicate_marking_options"
        },
        {
            "$ref": "#/$defs/reference_options"
        },
        {
            "$ref": "#/$defs/alignment_qc_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
