// Config for running the mark_duplicates pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/mark_duplicates'
    description  = 'Mark duplicates with samtools or Picard'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
