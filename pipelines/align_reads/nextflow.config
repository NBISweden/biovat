// Config for running the align_reads pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/align_reads'
    description  = 'Read alignment with bwa-mem3 or Parabricks'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
