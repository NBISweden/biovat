{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/NBISweden/biovat/main/pipelines/align_reads/nextflow_schema.json",
    "title": "BioVAT align_reads pipeline parameters",
    "description": "Align reads to a reference with bwa-mem3 or Parabricks, with optional alignment QC",
    "type": "object",
    "$defs": {
        "input_options": {
            "title": "Input options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data.",
            "properties": {
                "samplesheet": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "BioVAT samplesheet (CSV), the same file as for the main pipeline. Columns: sample, library_id, flowcell_id, lane, platform, fastq_1, fastq_2, bam, single_end. Rows with a bam instead of fastq files are skipped.",
                    "fa_icon": "fas fa-file-csv"
                },
                "reads": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Alternative to --samplesheet, for YAML or JSON files and for calling pipelines. One entry per read group, with meta (a map with at least read_group, id, library, pl and platform_unit) and reads (a list of fastq files, in order). Give either --samplesheet or --reads.",
                    "fa_icon": "fas fa-file"
                },
                "fasta": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Reference fasta file.",
                    "fa_icon": "fas fa-dna"
                },
                "fai": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Fai index of the reference fasta. Used by Riker. Created from --fasta when it is needed and not given.",
                    "fa_icon": "fas fa-file"
                }
            }
        },
        "stage_options": {
            "title": "Stage options",
            "type": "object",
            "fa_icon": "fas fa-cogs",
            "description": "Options of the stage.",
            "properties": {
                "aligner": {
                    "type": "string",
                    "default": "bwa-mem3",
                    "enum": ["bwa-mem3", "parabricks"],
                    "description": "Alignment tool choice.",
                    "fa_icon": "fas fa-hammer"
                },
                "cram_format": {
                    "type": "boolean",
                    "default": false,
                    "description": "Write CRAM instead of BAM.",
                    "fa_icon": "fas fa-file-archive"
                },
                "align_qc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run quality checks on the alignments (BAM/CRAM).",
                    "fa_icon": "fas fa-check"
                },
                "riker": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run Riker during the alignment QC. Needs --fasta, and its fai index, which is created when not given.",
                    "fa_icon": "fas fa-tools"
                },
                "qualimap": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run Qualimap during the alignment QC. Not compatible with cram_format.",
                    "fa_icon": "fas fa-tools"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "properties": {
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message.",
                    "fa_icon": "fas fa-question-circle"
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full help message.",
                    "fa_icon": "fas fa-question-circle"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_options"
        },
        {
            "$ref": "#/$defs/stage_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
