// Config for running the alignment_qc pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/alignment_qc'
    description  = 'Quality checks of alignments'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
