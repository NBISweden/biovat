nextflow_pipeline {

    name "Test pipeline alignment_qc"
    script "../main.nf"
    tag "pipelines"
    tag "pipelines/alignment_qc"

    test("sample level, from YAML - stub") {

        options "-stub -output-dir ${outputDir}"

        setup {
            // Stub mode does not read the files, so empty files are enough
            def rows = []
            ["A", "B"].each { name ->
                new File("${launchDir}/${name}.bam").text = ""
                new File("${launchDir}/${name}.bam.csi").text = ""
                rows << "- {meta: {id: ${name}, pl: ILLUMINA, single_end: false}, alignment: ${launchDir}/${name}.bam, index: ${launchDir}/${name}.bam.csi}"
            }
            new File("${launchDir}/alignments.yml").text = rows.join("\n") + "\n"
        }

        when {
            params {
                alignments = "${launchDir}/alignments.yml"
                level      = "sample"
                fasta      = "${projectDir}/tests/data/monkeyflower/M_aurantiacus_v1_splitline_ordered.fasta"
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    getAllFilesFromDir(outputDir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}']),
                ).match() }
            )
        }
    }

    test("library level, from a CSV samplesheet, without Riker - stub") {

        options "-stub -output-dir ${outputDir}"

        setup {
            def rows = [ "sample,library_id,platform,single_end,alignment,index" ]
            ["A_1", "B_1"].each { name ->
                new File("${launchDir}/${name}.bam").text = ""
                new File("${launchDir}/${name}.bam.csi").text = ""
                def (sample, library) = name.tokenize('_')
                rows << "${sample},${library},ILLUMINA,false,${launchDir}/${name}.bam,${launchDir}/${name}.bam.csi"
            }
            new File("${launchDir}/alignments.csv").text = rows.join("\n") + "\n"
        }

        when {
            params {
                samplesheet = "${launchDir}/alignments.csv"
                level       = "library"
                riker       = false
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    getAllFilesFromDir(outputDir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}']),
                ).match() }
            )
        }
    }

    test("library level without a library_id fails") {

        options "-stub -output-dir ${outputDir}"

        setup {
            new File("${launchDir}/a.bam").text = ""
            new File("${launchDir}/a.bam.csi").text = ""
            new File("${launchDir}/alignments.csv").text = "sample,library_id,platform,single_end,alignment,index\nA,,ILLUMINA,false,${launchDir}/a.bam,${launchDir}/a.bam.csi\n"
        }

        when {
            params {
                samplesheet = "${launchDir}/alignments.csv"
                level       = "library"
                riker       = false
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).toString().contains("needs a library_id for every row")
        }
    }

    test("missing --level fails") {

        options "-stub -output-dir ${outputDir}"

        setup {
            new File("${launchDir}/a.bam").text = ""
            new File("${launchDir}/a.bam.csi").text = ""
            new File("${launchDir}/alignments.csv").text = "sample,library_id,platform,single_end,alignment,index\nA,,ILLUMINA,false,${launchDir}/a.bam,${launchDir}/a.bam.csi\n"
        }

        when {
            params {
                samplesheet = "${launchDir}/alignments.csv"
                riker       = false
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).toString().contains("--level is required")
        }
    }

    test("an unknown --level fails") {

        options "-stub -output-dir ${outputDir}"

        setup {
            new File("${launchDir}/a.bam").text = ""
            new File("${launchDir}/a.bam.csi").text = ""
            new File("${launchDir}/alignments.yml").text = "- {meta: {id: A, pl: ILLUMINA, single_end: false}, alignment: ${launchDir}/a.bam, index: ${launchDir}/a.bam.csi}\n"
        }

        when {
            params {
                alignments = "${launchDir}/alignments.yml"
                level      = "lane"
                riker      = false
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).toString().contains("--level is required")
        }
    }

    test("--samplesheet and --alignments together fail") {

        options "-stub -output-dir ${outputDir}"

        setup {
            new File("${launchDir}/a.bam").text = ""
            new File("${launchDir}/a.bam.csi").text = ""
            new File("${launchDir}/alignments.csv").text = "sample,library_id,platform,single_end,alignment,index\nA,,ILLUMINA,false,${launchDir}/a.bam,${launchDir}/a.bam.csi\n"
            new File("${launchDir}/alignments.yml").text = "- {meta: {id: A, pl: ILLUMINA, single_end: false}, alignment: ${launchDir}/a.bam, index: ${launchDir}/a.bam.csi}\n"
        }

        when {
            params {
                samplesheet = "${launchDir}/alignments.csv"
                alignments  = "${launchDir}/alignments.yml"
                level       = "sample"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).toString().contains("Provide either --samplesheet or --alignments, not both")
        }
    }

    test("missing --samplesheet fails") {

        options "-stub -output-dir ${outputDir}"

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).toString().contains("Missing required parameter --samplesheet")
        }
    }
}
