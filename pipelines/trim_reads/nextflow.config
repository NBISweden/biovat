// Config for running the trim_reads pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/trim_reads'
    description  = 'Read trimming with fastp'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
