// Config for running the merge pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/merge'
    description  = 'Merge alignments to library or sample level with samtools'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
