// Config for running the multiqc pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/multiqc'
    description  = 'MultiQC report and software versions'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
