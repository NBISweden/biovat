// Config for running the call_variants pipeline on its own. It is not loaded when the pipeline is included by another pipeline.

includeConfig '../../conf/stage.config'

manifest {
    name         = 'NBISweden/biovat/call_variants'
    description  = 'Variant calling with bcftools or GATK'
    contributors = [ [ name: 'BioVAT developers', contribution: ['author'] ] ]
}
