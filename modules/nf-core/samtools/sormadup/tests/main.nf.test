nextflow_process {

    name "Test Process SAMTOOLS_SORMADUP"
    script "../main.nf"
    process "SAMTOOLS_SORMADUP"

    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/sormadup"

    test("sarscov2 - bam") {
        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [id: 'test'],
                    input: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    fai: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                    samtools_cat_args: null,
                    samtools_collate_args: null,
                    samtools_fixmate_args: null,
                    samtools_sort_args: null,
                    samtools_markdup_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("sarscov2 - cram") {
        config "./cram.config"
        when {
            params {
                modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            }
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [id: 'test'],
                    input: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    fai: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                    samtools_cat_args: null,
                    samtools_collate_args: null,
                    samtools_fixmate_args: null,
                    samtools_sort_args: null,
                    samtools_markdup_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            def fasta = params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta'
            assert process.success
            def out = process.out[0][0]
            assertAll(
                {
                    assert snapshot(
                        cram(out.cram, fasta).getReadsMD5(),
                        file(out.crai).name,
                        out.metrics
                    ).match()
                }
            )
        }
    }


    test("sarscov2 - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [id: 'test'],
                    input: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    fai: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                    samtools_cat_args: null,
                    samtools_collate_args: null,
                    samtools_fixmate_args: null,
                    samtools_sort_args: null,
                    samtools_markdup_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
