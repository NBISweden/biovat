    test("multiple bam") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.sorted.bam', checkIfExists: true)
                    ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    fai: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                    index_format: '',
                    samtools_sort_args: null,
                    output_prefix: null
