nextflow_process {

    name "Test Process SAMTOOLS_SORT"
    script "../main.nf"
    process "SAMTOOLS_SORT"
    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/sort"

    test("bam_no_index") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true) ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    fai: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                    index_format: '',
                    samtools_sort_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out[0].collect { r -> file(r.bam).name + ':readsMD5,' + bam(r.bam).getReadsMD5() },
                    process.out[0].collect { r -> [ r.meta, r.index ] }
                ).match() }
            )
        }
    }

    test("bam_bai_index") {

        config "./nextflow.config"

        when {
            process {
                """
