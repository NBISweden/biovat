                { assert snapshot(
                    process.out[0].collect { r -> file(r.bam).name + ':readsMD5,' + bam(r.bam).getReadsMD5() },
                    process.out[0].collect { r -> [ r.meta, r.index ? file(r.index).name : null ] }
                ).match() }
            )
        }
    }

