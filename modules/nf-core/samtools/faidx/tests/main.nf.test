nextflow_process {

    name "Test Process SAMTOOLS_FAIDX"
    script "../main.nf"
    process "SAMTOOLS_FAIDX"

    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/faidx"
    config "./nextflow.config"

    test("test_samtools_faidx") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    fai: null,
                    get_sizes: false,
                    samtools_faidx_args: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0].collect { r -> [ r.meta, r.fa, r.sizes, r.fai, r.gzi ] }).match()}
            )
        }
    }

    test("test_samtools_faidx_bgzip") {

        when {
            params {
                module_args = ''
            }
