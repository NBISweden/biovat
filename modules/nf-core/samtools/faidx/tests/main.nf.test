    }

    test("test_samtools_faidx_fasta") {

        when {
            params {
                module_args = 'MT192765.1 -o extract.fa'
            }
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    fai: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                    get_sizes: false,
                    samtools_faidx_args: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0].collect { r -> [ r.meta, r.fa, r.sizes, r.fai, r.gzi ] }).match()}
            )
        }
    }

