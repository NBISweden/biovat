nextflow_process {

    name "Test Process FASTP"
    script "../main.nf"
    process "FASTP"
    tag "modules"
    tag "modules_nfcore"
    tag "fastp"

    test("test_fastp_single_end") {

        when {

            process {
                """
                adapter_fasta        = null // no adapter file
                discard_trimmed_pass = false
                save_trimmed_fail    = false
                save_merged          = false

                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    single_end: true,
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ],
                    adapter_fasta: adapter_fasta,
                    discard_trimmed_pass: discard_trimmed_pass,
                    save_trimmed_fail: save_trimmed_fail,
                    save_merged: save_merged,
                    fastp_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out[0][0].html).getText().contains("single end (151 cycles)") },
                { assert path(process.out[0][0].log).getText().contains("reads passed filter: 99") },
                { assert snapshot(
                    process.out[0][0].reads.sort(),
                    process.out[0][0].reads_fail.sort(),
                    process.out[0][0].reads_merged).match()
                }
            )
        }
    }

    test("test_fastp_paired_end") {

        when {

            process {
                """
                adapter_fasta        = null
                discard_trimmed_pass = false
                save_trimmed_fail    = false
                save_merged          = false

                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    single_end: false,
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ],
                    adapter_fasta: adapter_fasta,
                    discard_trimmed_pass: discard_trimmed_pass,
                    save_trimmed_fail: save_trimmed_fail,
                    save_merged: save_merged,
                    fastp_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out[0][0].html).getText().contains("The input has little adapter percentage (~0.000000%), probably it's trimmed before.") },
                { assert path(process.out[0][0].log).getText().contains("Q30 bases: 12281(88.3716%)") },
                { assert snapshot(
                    process.out[0][0].reads.sort(),
                    process.out[0][0].reads_fail.sort(),
                    process.out[0][0].reads_merged).match() }
            )
        }
    }

    test("fastp test_fastp_interleaved") {

        config './nextflow.interleaved.config'
        when {
            process {
                """
                adapter_fasta        = null
                discard_trimmed_pass = false
                save_trimmed_fail    = false
                save_merged          = false

                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    single_end: true,
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_interleaved.fastq.gz', checkIfExists: true) ],
                    adapter_fasta: adapter_fasta,
                    discard_trimmed_pass: discard_trimmed_pass,
                    save_trimmed_fail: save_trimmed_fail,
                    save_merged: save_merged,
                    fastp_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out[0][0].html).getText().contains("paired end (151 cycles + 151 cycles)") },
                { assert path(process.out[0][0].log).getText().contains("reads passed filter: 162") },
                { assert process.out[0][0].reads_fail.isEmpty() },
                { assert process.out[0][0].reads_merged == null },
                { assert snapshot(
                    process.out[0][0].reads.sort(),
                    process.out[0][0].reads_fail.sort(),
                    process.out[0][0].reads_merged).match() }
            )
        }
    }

