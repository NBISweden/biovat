                    save_merged: save_merged,
                    fastp_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out[0][0].html).getText().contains("<div id='After_filtering__merged__quality'>") },
                { assert path(process.out[0][0].log).getText().contains("total bases: 13683") },
                { assert snapshot(
                    process.out[0][0].reads.sort(),
                    process.out[0][0].reads_fail.sort(),
                    process.out[0][0].reads_merged).match() }
            )
        }
    }

