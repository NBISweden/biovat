nextflow_process {

    name "Test Process BCFTOOLS_STATS"
    script "../main.nf"
    process "BCFTOOLS_STATS"

    tag "modules"
    tag "modules_nfcore"
    tag "bcftools"
    tag "bcftools/stats"

    test("sarscov2 - vcf_gz") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    vcf: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    tbi: null,
                    regions: null,
                    targets: null,
                    samples: null,
                    exons: null,
                    fasta: null,
                    bcftools_stats_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out[0][0].stats).readLines()[0..5]).match() }
            )
        }
    }


    test("sarscov2 - vcf_gz - regions") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'regions_test',
                    meta: [ id:'regions_test' ],
                    vcf: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    tbi: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    regions: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test3.vcf.gz', checkIfExists: true),
                    targets: null,
                    samples: null,
                    exons: null,
                    fasta: null,
                    bcftools_stats_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out[0][0].stats).readLines()[0..5]).match() }
            )
        }
    }


    test("sarscov2 - vcf_gz - targets") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'targets_test',
                    meta: [ id:'targets_test' ],
                    vcf: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    tbi: null,
                    regions: null,
                    targets: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.targets.tsv.gz', checkIfExists: true),
                    samples: null,
                    exons: null,
                    fasta: null,
                    bcftools_stats_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out[0][0].stats).readLines()[0..5]).match() }
            )
        }
    }


    test("sarscov2 - vcf_gz - exons") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'exon_test',
                    meta: [ id:'exon_test' ],
                    vcf: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    tbi: null,
                    regions: null,
                    targets: null,
                    samples: null,
                    exons: file(params.modules_testdata_base_path + 'delete_me/bcftools/stats/exons.tsv.gz', checkIfExists: true),
                    fasta: null,
                    bcftools_stats_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out[0][0].stats).readLines()[0..5]).match() }
            )
        }
    }


    test("sarscov2 - vcf_gz - reference") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'ref_test',
                    meta: [ id:'ref_test' ],
                    vcf: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    tbi: null,
                    regions: null,
                    targets: null,
                    samples: null,
                    exons: null,
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bcftools_stats_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out[0][0].stats).readLines()[0..5]).match() }
            )
        }
    }


    test("sarscov2 - vcf_gz - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    vcf: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    tbi: null,
                    regions: null,
                    targets: null,
                    samples: null,
                    exons: null,
                    fasta: null,
                    bcftools_stats_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0].collect { r -> [ r.id, r.meta, r.stats ] }).match() }
            )
        }
    }
}
