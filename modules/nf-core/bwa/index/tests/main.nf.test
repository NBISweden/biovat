nextflow_process {

    name "Test Process BWA_INDEX"
    tag "modules_nfcore"
    tag "modules"
    tag "bwa"
    tag "bwa/index"
    script "../main.nf"
    process "BWA_INDEX"

    test("BWA index") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [id: 'test'],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bwa_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("BWA index - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [id: 'test'],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bwa_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
