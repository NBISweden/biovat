nextflow_process {

    name "Test Process QUALIMAP_BAMQC"
    script "../main.nf"
    process "QUALIMAP_BAMQC"
    tag "modules"
    tag "modules_nfcore"
    tag "qualimap"
    tag "qualimap/bamqc"

    test("homo_sapiens [bam]") {
        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    single_end: false,
                    bam: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    gff: null,
                    qualimap_bamqc_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(
                    file("${process.out[0][0].results}/qualimapReport.html").name,
                    path("${process.out[0][0].results}/genome_results.txt"))
                    .match() }
            )
        }
    }

    test("homo_sapiens [bam] - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    single_end: false,
                    bam: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    gff: null,
                    qualimap_bamqc_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
