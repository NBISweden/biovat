nextflow_process {

    name "Test Process GATK4_CREATESEQUENCEDICTIONARY"
    script "../main.nf"
    process "GATK4_CREATESEQUENCEDICTIONARY"

    tag "modules"
    tag "modules_nfcore"
    tag "gatk4"
    tag "gatk4/createsequencedictionary"

    test("sarscov2 - fasta") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    gatk4_createsequencedictionary_args: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0].collect { r -> [ r.id, r.meta, r.dict ] }).match() }
            )
        }
    }

    test("sarscov2 - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    gatk4_createsequencedictionary_args: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0].collect { r -> [ r.id, r.meta, r.dict ] }).match() }
            )
        }
    }
}
