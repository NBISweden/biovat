nextflow_process {

    name "Test Process GATK4_GENOMICSDBIMPORT"
    script "../main.nf"
    process "GATK4_GENOMICSDBIMPORT"

    tag "modules"
    tag "modules_nfcore"
    tag "untar"
    tag "gatk4"
    tag "gatk4/genomicsdbimport"

    test("test_gatk4_genomicsdbimport_create_genomicsdb") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    vcf: [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz', checkIfExists: true) ],
                    tbi: [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz.tbi', checkIfExists: true) ],
                    interval_file: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.interval_list', checkIfExists: true),
                    interval_value: null,
                    wspace: null,
                    run_intlist: false,
                    run_updatewspace: false,
                    input_map: false,
                    gatk4_genomicsdbimport_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(file(process.out[0][0].genomicsdb).list().sort()).match() }
            )
        }
    }

    test("test_gatk4_genomicsdbimport_get_intervalslist") {

        setup {
            run("UNTAR") {
                script "../../../untar/main.nf"
                process {
                    """
                    input[0] = Channel.of([ [], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/test_genomicsdb.tar.gz', checkIfExists: true) ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = UNTAR.out.untar.map { meta, gendb ->
                    record(
                        id: 'test',
                        meta: [ id:'test' ],
                        vcf: [],
                        tbi: null,
                        interval_file: null,
                        interval_value: null,
                        wspace: gendb,
                        run_intlist: true,
                        run_updatewspace: false,
                        input_map: false,
                        gatk4_genomicsdbimport_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0][0].intervallist).match() }
            )
        }
    }

    test("test_gatk4_genomicsdbimport_update_genomicsdb") {

        setup {
            run("UNTAR") {
                script "../../../untar/main.nf"
                process {
                    """
                    input[0] = Channel.of([ [], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/test_genomicsdb.tar.gz', checkIfExists: true) ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = UNTAR.out.untar.map { meta, gendb ->
                    record(
                        id: 'test',
                        meta: [ id:'test' ],
                        vcf: [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test2.genome.vcf.gz', checkIfExists: true) ],
                        tbi: [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test2.genome.vcf.gz.tbi', checkIfExists: true) ],
                        interval_file: null,
                        interval_value: null,
                        wspace: gendb,
                        run_intlist: false,
                        run_updatewspace: true,
                        input_map: false,
                        gatk4_genomicsdbimport_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(file(process.out[0][0].updatedb).list().sort()).match() }
            )
        }
    }

    test("test_gatk4_genomicsdbimport_stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    vcf: [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz', checkIfExists: true) ],
                    tbi: [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz.tbi', checkIfExists: true) ],
                    interval_file: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.interval_list', checkIfExists: true),
                    interval_value: null,
                    wspace: null,
                    run_intlist: false,
                    run_updatewspace: false,
                    input_map: false,
                    gatk4_genomicsdbimport_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                {
                    assert snapshot(process.out[0].collect { r ->
                        [ r.id, r.meta, file(r.genomicsdb).name, r.updatedb, r.intervallist ]
                    }).match()
                }
            )
        }
    }
}
