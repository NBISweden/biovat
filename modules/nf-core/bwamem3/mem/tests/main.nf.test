nextflow_process {

    name "Test Process BWAMEM3_MEM"
    script "../main.nf"
    process "BWAMEM3_MEM"

    tag "modules"
    tag "modules_nfcore"
    tag "bwamem3"
    tag "bwamem3/mem"
    tag "bwamem3/index"

    setup {
        run("BWAMEM3_INDEX") {
            script "../../index/main.nf"
            process {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [:],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bwamem3_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }
    }

    test("sarscov2 - fastq, index, fasta, false") {

        when {
            process {
                """
                input[0] = BWAMEM3_INDEX.out.map { idx ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:true ],
                        reads: [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)],
                        index: idx.index,
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        sort_bam: false,
                        bwamem3_mem_args: null,
                        samtools_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out[0][0].aligned).getHeaderMD5(),
                    bam(process.out[0][0].aligned).getReadsMD5()
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq, index, fasta, true") {

        when {
            process {
                """
                input[0] = BWAMEM3_INDEX.out.map { idx ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:true ],
                        reads: [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)],
                        index: idx.index,
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        sort_bam: true,
                        bwamem3_mem_args: null,
                        samtools_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out[0][0].aligned).getHeaderMD5(),
                    bam(process.out[0][0].aligned).getReadsMD5()
                ).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, false") {

        when {
            process {
                """
                input[0] = BWAMEM3_INDEX.out.map { idx ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:false ],
                        reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ],
                        index: idx.index,
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        sort_bam: false,
                        bwamem3_mem_args: null,
                        samtools_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out[0][0].aligned).getHeaderMD5(),
                    bam(process.out[0][0].aligned).getReadsMD5()
                ).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, true") {

        when {
            process {
                """
                input[0] = BWAMEM3_INDEX.out.map { idx ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:false ],
                        reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ],
                        index: idx.index,
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        sort_bam: true,
                        bwamem3_mem_args: null,
                        samtools_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out[0][0].aligned).getHeaderMD5(),
                    bam(process.out[0][0].aligned).getReadsMD5()
                ).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, true - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = BWAMEM3_INDEX.out.map { idx ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:false ],
                        reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ],
                        index: idx.index,
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        sort_bam: true,
                        bwamem3_mem_args: null,
                        samtools_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0][0].meta, file(process.out[0][0].aligned.toString()).name, process.out[0][0].index ? file(process.out[0][0].index.toString()).name : null).match() }
            )
        }
    }

}
