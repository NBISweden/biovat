nextflow_process {

    name "Test Process BWAMEM3_INDEX"
    script "../main.nf"
    process "BWAMEM3_INDEX"

    tag "modules"
    tag "modules_nfcore"
    tag "bwamem3"
    tag "bwamem3/index"

    test("sarscov2 - fasta") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bwamem3_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("sarscov2 - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bwamem3_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
