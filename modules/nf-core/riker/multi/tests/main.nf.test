nextflow_process {

    name "Test Process RIKER_MULTI"
    script "../main.nf"
    process "RIKER_MULTI"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "riker"
    tag "riker/multi"

    test("sarscov2 - paired_end - bam - alignment basic isize") {

        when {
            params {
                module_args = '--tools alignment basic isize'
            }
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true),
                    error_vcf: null,
                    error_vcf_idx: null,
                    error_intervals: null,
                    gcbias_exclude_intervals: null,
                    hybcap_baits: null,
                    hybcap_targets: null,
                    rna_gene_model: null,
                    rna_ribosomal_intervals: null,
                    wgs_intervals: null,
                    fasta: null,
                    fai: null,
                    riker_multi_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0].collect { r -> r.collectEntries { k, v ->
                    k in ['pdf'] ? [ (k): v instanceof Collection ? v.collect { f -> file(f).name }.sort() : (v ? file(v).name : null) ] : [ (k): v ]
                } }).match() }
            )
        }
    }

