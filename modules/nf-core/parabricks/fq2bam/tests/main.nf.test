nextflow_process {

    name "Test Process PARABRICKS_FQ2BAM"
    script "../main.nf"
    process "PARABRICKS_FQ2BAM"

    tag "bwa/index"
    tag "modules"
    tag "parabricks/fq2bam"
    tag "modules_nfcore"
    tag "parabricks"
    tag "gpu"

    config './nextflow.config'

    setup {
        run("BWA_INDEX") {
            script "../../../bwa/index/main.nf"
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file('https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome.fa', checkIfExists: true),
                    bwa_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        run("BWA_INDEX", alias: 'BWA_INDEX_PE') {
            script "../../../bwa/index/main.nf"
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bwa_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        run("BWA_INDEX", alias: 'BWA_INDEX_CRAM') {
            script "../../../bwa/index/main.nf"
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    bwa_index_args: null,
                    output_prefix: null
                ))
                """
            }
        }
    }

    test("SRR389222 - fastq - se") {

        config './nextflow.config'

        when {
            params {
                module_args = ''
                bwa_prefix = 'genome.fa'
            }
            process {
                """
                input[0] = BWA_INDEX.out.map { bwa ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:true ],
                        single_end: true,
                        reads: [
                            file('https://github.com/nf-core/test-datasets/raw/methylseq/testdata/SRR389222_sub1.fastq.gz', checkIfExists: true)
                        ],
                        fasta: file('https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome.fa', checkIfExists: true),
                        index: bwa.index,
                        intervals: null,
                        known_sites: null,
                        known_sites_index: null,
                        output_fmt: 'bam',
                        parabricks_fq2bam_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out[0][0].bam).getReadsMD5(),
                    file(process.out[0][0].bai).name
                ).match() }
            )
        }
    }

    test("SRR389222 - fastq - se - stub") {

        options '-stub'

        when {
            params {
                module_args = ''
                bwa_prefix = ''
            }
            process {
                """
                input[0] = BWA_INDEX.out.map { bwa ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:true ],
                        single_end: true,
                        reads: [
                            file('https://github.com/nf-core/test-datasets/raw/methylseq/testdata/SRR389222_sub1.fastq.gz', checkIfExists: true)
                        ],
                        fasta: file('https://github.com/nf-core/test-datasets/raw/methylseq/reference/genome.fa', checkIfExists: true),
                        index: bwa.index,
                        intervals: null,
                        known_sites: null,
                        known_sites_index: null,
                        output_fmt: 'bam',
                        parabricks_fq2bam_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out,
                    path(process.out[0][0].compatible_versions).yaml
                    ).match() }
            )
        }
    }

    test("sarscov2 - fastq - pe") {

        when {
            params {
                module_args = ''
                bwa_prefix = 'genome.fasta'
            }
            process {
                """
                input[0] = BWA_INDEX_PE.out.map { bwa ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:false ],
                        single_end: false,
                        reads: [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        index: bwa.index,
                        intervals: null,
                        known_sites: null,
                        known_sites_index: null,
                        output_fmt: 'bam',
                        parabricks_fq2bam_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out[0][0].bam).getReadsMD5(),
                    file(process.out[0][0].bai).name
                ).match() }
            )
        }

    }

    test("sarscov2 - fastq - pe - stub") {

        options '-stub'

        when {
            params {
                module_args = ''
                bwa_prefix = ''
            }
            process {
                """
                input[0] = BWA_INDEX_PE.out.map { bwa ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:false ],
                        single_end: false,
                        reads: [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        index: bwa.index,
                        intervals: null,
                        known_sites: null,
                        known_sites_index: null,
                        output_fmt: 'bam',
                        parabricks_fq2bam_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out,
                    path(process.out[0][0].compatible_versions).yaml
                    ).match() }
            )
        }

    }

    test("sarscov2 - fastq - se - cram") {

        when {
            params {
                module_args = ''
                bwa_prefix = 'genome.fasta'
            }
            process {
                """
                input[0] = BWA_INDEX_CRAM.out.map { bwa ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:true ],
                        single_end: true,
                        reads: [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                        ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        index: bwa.index,
                        intervals: null,
                        known_sites: null,
                        known_sites_index: null,
                        output_fmt: 'cram',
                        parabricks_fq2bam_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            def fasta = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/sarscov2/genome/genome.fasta"
            assertAll(
                { assert process.success },
                { assert snapshot(
                    cram(
                        process.out[0][0].cram,
                        fasta,
                        ).getReadsMD5(),
                    file(process.out[0][0].crai).name
                ).match() }
            )
        }

    }

    test("sarscov2 - fastq - pe - cram - stub") {

        options '-stub'

        when {
            params {
                module_args = ''
                bwa_prefix = ''
            }
            process {
                """
                input[0] = BWA_INDEX_PE.out.map { bwa ->
                    record(
                        id: 'test',
                        meta: [ id:'test', single_end:false ],
                        single_end: false,
                        reads: [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        index: bwa.index,
                        intervals: null,
                        known_sites: null,
                        known_sites_index: null,
                        output_fmt: 'cram',
                        parabricks_fq2bam_args: null,
                        output_prefix: null
                    )
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match()}
            )
        }

    }

}
