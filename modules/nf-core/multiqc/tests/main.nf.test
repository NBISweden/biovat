nextflow_process {

    name "Test Process MULTIQC"
    script "../main.nf"
    process "MULTIQC"

    tag "modules"
    tag "modules_nfcore"
    tag "multiqc"

    config "./nextflow.config"

    test("sarscov2 single-end [fastqc]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    meta: [ id: 'FASTQC' ],
                    multiqc_files: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true) ],
                    multiqc_config: null,
                    multiqc_logo: null,
                    replace_names: null,
                    sample_names: null,
                    multiqc_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                [
                    meta: process.out[0][0].meta,
                    report: file(process.out[0][0].report.toString()).name,
                    data: path(process.out[0][0].data).list().collect { file(it.toString()).name },
                    plots: process.out[0][0].plots ? [
                        "pdf",
                        path("${process.out[0][0].plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${process.out[0][0].plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${process.out[0][0].plots}/svg").list().collect { file(it.toString()).name }] : null,
                    versions: process.out[0][0].versions
                ]
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] - custom prefix") {
        config "./custom_prefix.config"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    meta: [ id: 'FASTQC' ],
                    multiqc_files: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true) ],
                    multiqc_config: null,
                    multiqc_logo: null,
                    replace_names: null,
                    sample_names: null,
                    multiqc_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                [
                    meta: process.out[0][0].meta,
                    report: file(process.out[0][0].report.toString()).name,
                    data: path(process.out[0][0].data).list().collect { file(it.toString()).name },
                    plots: process.out[0][0].plots ? [
                        "pdf",
                        path("${process.out[0][0].plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${process.out[0][0].plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${process.out[0][0].plots}/svg").list().collect { file(it.toString()).name }] : null,
                    versions: process.out[0][0].versions
                ]
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] [config]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    meta: [ id: 'FASTQC' ],
                    multiqc_files: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true) ],
                    multiqc_config: [ file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true) ],
                    multiqc_logo: null,
                    replace_names: null,
                    sample_names: null,
                    multiqc_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                [
                    meta: process.out[0][0].meta,
                    report: file(process.out[0][0].report.toString()).name,
                    data: path(process.out[0][0].data).list().collect { file(it.toString()).name },
                    plots: process.out[0][0].plots ? [
                        "pdf",
                        path("${process.out[0][0].plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${process.out[0][0].plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${process.out[0][0].plots}/svg").list().collect { file(it.toString()).name }] : null,
                    versions: process.out[0][0].versions
                ]
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] [multiple configs]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    meta: [ id: 'FASTQC' ],
                    multiqc_files: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true) ],
                    multiqc_config: [
                        file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true),
                        file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true)
                    ],
                    multiqc_logo: null,
                    replace_names: null,
                    sample_names: null,
                    multiqc_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                [
                    meta: process.out[0][0].meta,
                    report: file(process.out[0][0].report.toString()).name,
                    data: path(process.out[0][0].data).list().collect { file(it.toString()).name },
                    plots: process.out[0][0].plots ? [
                        "pdf",
                        path("${process.out[0][0].plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${process.out[0][0].plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${process.out[0][0].plots}/svg").list().collect { file(it.toString()).name }] : null,
                    versions: process.out[0][0].versions
                ]
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    meta: [ id: 'FASTQC' ],
                    multiqc_files: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true) ],
                    multiqc_config: null,
                    multiqc_logo: null,
                    replace_names: null,
                    sample_names: null,
                    multiqc_args: null,
                    output_prefix: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0][0].meta, file(process.out[0][0].report.toString()).name, process.out[0][0].versions).match() }
            )
        }
    }
}
