                    variant_file: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    bed: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true),
                    diff_variant_file: null,
                    vcftools_args: '--freq --exclude-bed',
