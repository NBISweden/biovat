nextflow_process {

    name "Test Process SPLITGENOME"
    script "../main.nf"
    process "SPLITGENOME"
    tag "modules_local"
    tag "splitgenome"

    setup {
        run("SAMTOOLS_FAIDX") {
            script "../../../nf-core/samtools/faidx/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'monkeyflower' ],
                    file("${projectDir}/tests/data/monkeyflower/M_aurantiacus_v1_splitline_ordered.fasta", checkIfExists: true),
                    []
                ])
                input[1] = false
                """
            }
        }
    }

    test("default min_length - LG4_3 (940 bp) is dropped") {

        when {
            process {
                """
                input[0] = SAMTOOLS_FAIDX.out.fai
                input[1] = ''
                input[2] = params.min_length // pipeline default (1000), so this tracks any change to it
                """
            }
        }

        then {
            def contigs = process.out.chunks[0][1]
                .with { it instanceof List ? it : [it] }
                .collectMany { bed -> path(bed).readLines() }
                .collect { line -> line.tokenize('\t')[0] }
            def stderr = path(process.out.chunks[0][1][0]).getParent().resolve('.command.err').text
            def excluded = path(process.out.excluded[0][1]).readLines()
            def summary = path(process.out.summary[0][1]).readLines().findAll { line -> !line.startsWith('#') }
            assertAll(
                { assert process.success },
                { assert contigs == ['LG4_1', 'LG4_2'] },
                { assert excluded == ['chrom\tlength', 'LG4_3\t940'] },
                { assert summary[1].tokenize('\t') == ['M_aurantiacus_v1_splitline_ordered.fasta', '2', '1', '99060', '940', '0.94', '51180', '2'] },
                { assert stderr.contains('excluded 1 of 3 regions (940 of 100000 bp') && stderr.contains('LG4_3') }
            )
        }
    }

    test("chunk_size below longest contig - raised, one contig per chunk") {

        when {
            process {
                """
                input[0] = SAMTOOLS_FAIDX.out.fai
                input[1] = 1000 // longest contig is LG4_2 (51180 bp)
                input[2] = 500
                """
            }
        }

        then {
            def beds = process.out.chunks[0][1]
            def chunks = beds.collect { bed -> path(bed).readLines().collect { line -> line.tokenize('\t')[0] } }
            // chunk BEDs are written to the task work dir, alongside the script's stderr
            def stderr = path(beds[0]).getParent().resolve('.command.err').text
            assertAll(
                { assert process.success },
                // Contigs are never split, so each one gets a chunk to itself
                { assert chunks == [['LG4_1'], ['LG4_2'], ['LG4_3']] },
                { assert stderr.contains('raising --chunk_size to 51180') }
            )
        }
    }

    test("default chunk_size, fragmented assembly - capped at DEFAULT_TARGET_CHUNKS") {

        when {
            process {
                """
                // 200 x 1000 bp scaffolds: longest (1000) is below total / 50 (4000), so the default is 4000
                def fai = file("\${workDir}/fragmented.fasta.fai")
                fai.text = (1..200).collect { i -> "scaffold_\${i}\\t1000\\t0\\t60\\t61\\n" }.join()
                input[0] = channel.of([ [ id:'fragmented' ], fai ])
                input[1] = ''
                input[2] = 0
                """
            }
        }

        then {
            def beds = process.out.chunks[0][1]
            def summary = path(process.out.summary[0][1]).readLines().findAll { line -> !line.startsWith('#') }
            assertAll(
                { assert process.success },
                // Chunk size, Chunks
                { assert summary[1].tokenize('\t')[6..7] == ['4000', '50'] },
                { assert beds.size() == 50 },
                { assert beds.every { bed -> path(bed).readLines().size() == 4 } }
            )
        }
    }

    test("min_length below 940, default chunk_size on contiguous assembly - LG4_3 kept, longest contig") {

        when {
            process {
                """
                input[0] = SAMTOOLS_FAIDX.out.fai
                input[1] = ''
                input[2] = 500 // keep all contigs: 100000 bp total, so total / 50 (2000) is below the longest (51180)
                """
            }
        }

        then {
            def chunks = process.out.chunks[0][1].collect { bed -> path(bed).readLines().collect { line -> line.tokenize('\t')[0] } }
            def summary = path(process.out.summary[0][1]).readLines().findAll { line -> !line.startsWith('#') }
            assertAll(
                { assert process.success },
                { assert summary[1].tokenize('\t')[6..7] == ['51180', '3'] },
                { assert chunks == [['LG4_1'], ['LG4_2'], ['LG4_3']] },
                { assert path(process.out.excluded[0][1]).readLines() == ['chrom\tlength'] }
            )
        }
    }

    test("chunk_size above total genome size - single chunk") {

        when {
            process {
                """
                input[0] = SAMTOOLS_FAIDX.out.fai
                input[1] = 200000 // total is 100000 bp
                input[2] = 500
                """
            }
        }

        then {
            // A single output file is emitted as a path, not a list
            def beds = process.out.chunks[0][1].with { it instanceof List ? it : [it] }
            def summary = path(process.out.summary[0][1]).readLines().findAll { line -> !line.startsWith('#') }
            assertAll(
                { assert process.success },
                { assert summary[1].tokenize('\t')[6..7] == ['200000', '1'] },
                { assert beds.size() == 1 },
                { assert path(beds[0]).readLines().collect { line -> line.tokenize('\t')[0] } == ['LG4_1', 'LG4_2', 'LG4_3'] }
            )
        }
    }

    test("min_length above every contig - fails") {

        when {
            process {
                """
                input[0] = SAMTOOLS_FAIDX.out.fai
                input[1] = ''
                input[2] = 60000 // longest contig is LG4_2 (51180 bp)
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                // Fail for the right reason: everything filtered out, not e.g. a container error
                { assert process.stdout.any { line -> line.contains('all chromosomes were filtered out by --min_length=60000') } }
            )
        }
    }
}
