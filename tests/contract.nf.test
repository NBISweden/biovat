nextflow_function {

    name "Test that the places that describe the same thing agree"
    script "./utils/contract.nf"
    tag "contract"

    // A check has to fail on input that differs, not pass because it found nothing to compare
    test("a stage schema that differs from the root schema is reported") {

        function "rootStageDiff"

        when {
            function {
                """
                input[0] = "${projectDir}/tests/utils/fixtures/contract_root.json"
                input[1] = "${projectDir}/tests/utils/fixtures/contract_stage.json"
                input[2] = [ 'alignments' ]
                """
            }
        }

        then {
            assert function.success
            assert function.result.size() == 3
            assert function.result.any { it.contains("--caller: enum is [a, c] in the stage and [a, b] in the root") }
            assert function.result.any { it.contains("--size: minimum is null in the stage and 1 in the root") }
            assert function.result.any { it.contains("--orphan of the stage has no counterpart in the root schema") }
        }
    }

    test("pipelines/align_reads agrees with the root schema") {

        function "rootStageDiff"

        when {
            function {
                """
                input[0] = "${projectDir}/nextflow_schema.json"
                input[1] = "${projectDir}/pipelines/align_reads/nextflow_schema.json"
                input[2] = [ 'reads', 'fai' ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == [], function.result.join("\n")
        }
    }

    test("pipelines/alignment_qc agrees with the root schema") {

        function "rootStageDiff"

        when {
            function {
                """
                input[0] = "${projectDir}/nextflow_schema.json"
                input[1] = "${projectDir}/pipelines/alignment_qc/nextflow_schema.json"
                input[2] = [ 'level', 'alignments', 'fai' ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == [], function.result.join("\n")
        }
    }

