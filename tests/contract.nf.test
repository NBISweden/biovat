    test("the pinned versions agree") {

        function "pinsDiff"

        when {
            function {
                """
                input[0] = "${projectDir}"
                """
            }
        }

        then {
            assert function.success
            assert function.result == [], function.result.join("\n")
        }
    }

    test("the docs name parameters that exist") {

        function "docNamesDiff"

        when {
            function {
                """
                input[0] = "${projectDir}"
                // flags of the tools and of the container engines that docs/usage.md describes, and the Slurm project
                input[1] = [ 'annotate', 'consensus', 'dbsnp', 'emit', 'gpus', 'group', 'merge', 'multiallelic', 'nv', 'ploidy', 'project', 'variants' ]
                """
