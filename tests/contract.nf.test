    test("the samplesheet columns agree") {

        function "samplesheetColumnsDiff"

        when {
            function {
                """
                input[0] = "${projectDir}"
                // BioVAT does not use the index of a BAM/CRAM row of --input, so the Sample record has no field for it
                input[1] = [ 'index' ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == [], function.result.join("\n")
        }
    }
