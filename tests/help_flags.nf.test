nextflow_function {

    name "Test the help message"
    script "./utils/help.nf"
    function "helpFlagsDiff"
    tag "help"

    // The message names its flags: a renamed or removed parameter that the message still suggests fails here
    test("BioVAT --help names parameters that exist") {

        when {
            function {
                """
                input[0] = "${projectDir}/main.nf"
                input[1] = "${projectDir}/nextflow_schema.json"
                input[2] = "fasta"
                """
            }
        }

        then {
            assert function.success
            assert function.result == [], function.result.join("\n")
        }
    }

    test("pipelines/align_reads --help names parameters that exist") {

        when {
            function {
                """
                input[0] = "${projectDir}/pipelines/align_reads"
                input[1] = "${projectDir}/pipelines/align_reads/nextflow_schema.json"
                input[2] = "samplesheet"
                """
            }
        }

        then {
            assert function.success
            assert function.result == [], function.result.join("\n")
        }
    }

