            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().any { task -> task.name.contains('MULTIQC') } },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('RIKER_MULTI') } },
                // A gate leaves the rest of the pipeline running
                { assert workflow.trace.tasks().size() > 10 }
            )
        }
