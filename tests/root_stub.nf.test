nextflow_pipeline {

    name "Test the root pipeline in stub mode"
    script "../main.nf"
    tag "pipeline"

    // Each gate switches its processes off. The other gates stay on, so a gate that does nothing, or one that switches
    // off more than it names, is found by the processes that are left
    test("enable_raw_read_qc false switches off READ_QC:FASTQC - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                enable_raw_read_qc = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().any { task -> task.name.contains('MULTIQC') } },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('READ_QC:FASTQC') } },
                // A gate leaves the rest of the pipeline running
                { assert workflow.trace.tasks().size() > 10 }
            )
        }
    }

    test("enable_trim false switches off TRIM_READS:FASTP - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                enable_trim = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().any { task -> task.name.contains('MULTIQC') } },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('TRIM_READS:FASTP') } },
                // A gate leaves the rest of the pipeline running
                { assert workflow.trace.tasks().size() > 10 }
            )
        }
    }

    test("enable_align false switches off ALIGN_READS:BWAMEM3_MEM - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                enable_align = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
