                enable_variant_calling = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().any { task -> task.name.contains('MULTIQC') } },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('CALL_VARIANTS:') } },
