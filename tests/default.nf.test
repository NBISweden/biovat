nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        setup {
            def resolved_samplesheet = new File("${launchDir}/samplesheet_resolved.csv")
            resolved_samplesheet.text = "sample,library_id,lane,platform,fastq_1,fastq_2\n" +
                "S03,1,7,illumina,${projectDir}/tests/data/S03_14_L7.BH252YCCXY.R1.fastq.gz,${projectDir}/tests/data/S03_14_L7.BH252YCCXY.R2.fastq.gz\n"
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "${launchDir}/samplesheet_resolved.csv"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/biovat_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
