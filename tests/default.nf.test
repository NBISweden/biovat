nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // bam_read_md5s: any BAM file in ${params.outdir}
            def outdir_path = file(params.outdir).toPath()
            def bam_read_md5s = getAllFilesFromDir(params.outdir)
                .findAll { f -> f.toString().endsWith('.bam') }
                .sort { f -> f.toString() }
                .collect { f -> "${outdir_path.relativize(f.toPath())}:${bam(f.toString()).getReadsMD5()}" }
            // vcf_variant_md5s: any VCF file in ${params.outdir}
            def vcf_variant_md5s = getAllFilesFromDir(params.outdir)
                .findAll { f -> f.toString().endsWith('.vcf') || f.toString().endsWith('.vcf.gz') }
                .sort { f -> f.toString() }
                .collect { f -> "${outdir_path.relativize(f.toPath())}:${path(f.toString()).vcf.variantsMD5}" }
            assert workflow.success
            assertAll(
                // PUN-R-ELF_2.bam has no @RG line: INGEST_BAM_OR_CRAM must warn that it's filling one in from the samplesheet
                { assert file("${launchDir}/meta/nextflow.log").text.contains("No @RG header line in 'PUN-R-ELF_2.bam'") },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/biovat_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                    // Unstable content checks handled by dedicated plugins
                    // BAMs: use nft-bam to validate stable hashes on all alignments, ignoring headers
                    bam_read_md5s,
                    // VCFs: use nft-vcf to validate stable hashes on all variant records, ignoring headers
                    vcf_variant_md5s,
                ).match() }
            )
        }
    }
}
