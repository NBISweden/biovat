nextflow_pipeline {

    name "Test pipeline help"
    script "../main.nf"
    tag "pipeline"
    tag "help"

    test("--helpFull") {

        when {
            params {
                helpFull = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("--help of a parameter that does not exist fails") {

        when {
            params {
                help = "nonexistent"
            }
        }

        then {
            assert workflow.failed
        }
    }
}
