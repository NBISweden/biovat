nextflow_pipeline {

    name "Test pipeline help"
    script "../main.nf"
    tag "pipeline"
    tag "help"

    test("--help") {

        when {
            params {
                help = "true"
            }
        }

        then {
            // The help message itself is not captured by nf-test. This checks that --help is reached and exits
            // cleanly, i.e. that no required parameter blocks it
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("--help <parameter>") {

        when {
            params {
                help = "fasta"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("--helpFull") {

        when {
            params {
                helpFull = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("--help of a parameter that does not exist fails") {

        when {
            params {
                help = "nonexistent"
            }
        }

        then {
            assert workflow.failed
        }
    }
}
